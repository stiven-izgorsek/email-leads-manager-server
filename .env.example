# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=email_leads_manager
DB_POOL_MAX=20

# OpenAI (compose, application, AI templates)
OPEN_AI_API_KEY=
OPEN_AI_MODEL=gpt-4o-mini
OPEN_AI_TIMEOUT_MS=25000

# Apollo company search
APOLLO_API_KEY=

# Millions Verify (lead email validation)
MILLIONS_API_KEY=

# Slack webhook for incoming message notifications
SLACK_INCOMING_MESSAGES_WEBHOOK=

# Nylas (optional region hint; grant/key are stored per mailbox in DB)
NYLAS_REGION=

# Marketing pipeline
MARKETING_USE_AI_COMPOSE=true
MARKETING_SEND_DELAY_MIN_MS=180000
MARKETING_SEND_DELAY_MAX_MS=300000
MARKETING_MAX_PARALLEL_MAILBOXES=5
MARKETING_STUCK_RUNNING_MS=2700000

# Follow-up pipeline
FOLLOWUP_MAX_PARALLEL_MAILBOXES=5
FOLLOWUP_STUCK_RUNNING_MS=2700000
FOLLOWUP_ASSIGN_ALL_CONCURRENCY=4

# Nylas polling & calendar sync
NYLAS_POLL_MS=60000
NYLAS_POLL_STAGGER_MS=400
NYLAS_PAGE_GAP_MS=150
NYLAS_429_MAX_RETRIES=2
CALENDAR_SYNC_INTERVAL_MS=3600000
